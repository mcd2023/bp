  <main>
    <section id="home" class="hero">
      <div class="hero-content">
        <span class="eyebrow">WEB DESIGN & FRONT-END</span>
        <h1>Modern Websites & <span>Landing Pages</span></h1>
        <p>
          Hello, I'm Bahar Pala. I create modern, responsive and
          user-friendly websites, portfolios and landing pages.
        </p>
        <div class="hero-actions">
          <a class="btn primary"
             href="https://wa.me/905078747215"
             target="_blank" rel="noopener noreferrer">
            Let's Discuss Your Project
          </a>
          <a class="btn secondary" href="#projects">View My Projects</a>
        </div>
      </div>

      <div class="hero-card" aria-label="Web development example">
        <div class="code-window">
          <div class="window-top" aria-hidden="true">
            <i></i><i></i><i></i>
          </div>
          <div class="code-line"><span>&lt;h1&gt;</span> creative ideas <span>&lt;/h1&gt;</span></div>
          <div class="code-line"><span>.design</span> { modern: true; }</div>
          <div class="code-line"><span>const</span> passion = "web";</div>
          <div class="code-line accent">// from idea to launch</div>
        </div>
      </div>
    </section>

    <section id="about" class="section">
      <div class="section-title"><span>01</span><h2>About Me</h2></div>
      <div class="about-grid">
        <div>
          <p class="lead">Creative web design focused on usability and user experience.</p>
          <p>I build accessible, attractive and responsive interfaces using HTML, CSS and JavaScript.</p>
          <div class="contact-mini">
            <span>Izmir, Türkiye</span>
            <a href="mailto:baharpalaux@outlook.com">baharpalaux@outlook.com</a>
          </div>
        </div>
        <div class="stats">
          <div><strong>HTML</strong><span>Web Structure</span></div>
          <div><strong>CSS</strong><span>Modern Design</span></div>
          <div><strong>JS</strong><span>Interactions</span></div>
          <div><strong>UI/UX</strong><span>User Focus</span></div>
        </div>
      </div>
    </section>

    <section id="skills" class="section">
      <div class="section-title"><span>02</span><h2>My Skills</h2></div>
      <div class="skills">
        <div class="skill"><b>HTML5</b><span>Semantic and accessible structure</span></div>
        <div class="skill"><b>CSS3</b><span>Responsive modern interfaces</span></div>
        <div class="skill"><b>JavaScript</b><span>Interactive user experiences</span></div>
        <div class="skill"><b>GitHub</b><span>Version control and deployment</span></div>
        <div class="skill"><b>Figma</b><span>Interface design and prototyping</span></div>
        <div class="skill"><b>UI / UX</b><span>User-centered design</span></div>
      </div>
    </section>

    <section id="projects" class="section">
      <div class="section-title"><span>03</span><h2>My Projects</h2></div>
      <div class="project-grid">
        <article class="project">
          <a href="https://chefco.com" class="project-image chefco"
